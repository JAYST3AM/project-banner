# Godot 4+ ------------------------------------------------------------------
# Godot's imported/cache data is generated locally and must never be committed.
.godot/
.import/
export.cfg
export_presets.cfg

# Godot's exported builds / temp export dirs
build/
exports/

# Imported translations
*.translation

# Mono / .NET (unused for Project Banner, kept for future-proofing)
.mono/
data_*/
mono_crash.*.json

# OS / editor noise ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
.vscode/
.idea/

# Local scratch / logs ------------------------------------------------------
*.log
/tmp/
/tools/local/

# Native accelerator (Step 7.7) ---------------------------------------------
# godot-cpp is fetched and pinned by native/build.sh into this path; it is a dependency
# checkout, not project source, and never committed.
native/deps/
native/.sconsign.dblite
# The built library is a generated artifact: CI builds it, developers build it, git does not.
addons/pb_native/bin/
# Engine API dumps are generated with --dump-extension-api for verification, never shipped.
extension_api.json
