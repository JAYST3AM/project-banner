; Engine configuration file.
; Project Banner - medieval sandbox strategy / RPG.
;
; Godot 4.7.2-stable. If you change the main scene or autoloads here, update
; /docs/GAME_ARCHITECTURE.md in the same commit.

config_version=5

[application]

; 0 is unlimited. Stated rather than inherited.
run/max_fps=0

config/name="Project Banner"
config/description="A persistent medieval sandbox: individual soldiers, tactical battles, and a living campaign world."
config/version="0.1.0"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

DebugLogger="*res://scripts/core/debug_logger.gd"
GameData="*res://scripts/core/game_data.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
FpsOverlay="*res://scripts/ui/fps_overlay.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

; The frame rate is never to be capped or synchronised: the owner wants the counter free to climb,
; and a vsynced frame time is the monitor's, not the game's. The simulation runs on its own 60 Hz
; clock, which is where the honest rate lives.
window/vsync/vsync_mode=0

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0

[physics]

; Thirty, stated rather than inherited, and following the battle clock in
; data/config/game_config.json - the owner asked to try half the rate and see what it reads like.
; and a rate that matters should be written down where it can be read and disagreed with instead of
; being an assumption nobody can find.
common/physics_ticks_per_second=30
